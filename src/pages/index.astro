---
import Layout from '../layouts/Layout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import PricingCard from '../components/PricingCard.astro';
import Faq from '../components/Faq.astro';
import PaymentPath from '../components/PaymentPath.astro';

const features = [
  {
    icon: '<svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16v3H4V5Zm0 6h16v3H4v-3Zm0 6h10v3H4v-3Z" fill="currentColor"/></svg>',
    title: 'Invoices in under a minute',
    description: 'Build a professional invoice from a saved client and line-item template, then send it before your coffee cools.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4Z" stroke="currentColor" stroke-width="1.6"/></svg>',
    title: 'PCI-compliant checkout',
    description: 'Every payment page is hosted and encrypted for you, so client card data never touches your own servers.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none"><path d="M3 12h4l2-7 6 14 2-7h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    title: 'Live payment tracking',
    description: 'Watch each invoice move from sent to viewed to paid, with automatic reminders for anything left open.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.6"/></svg>',
    title: 'Multiple payout methods',
    description: 'Get paid by card, ACH, or wire, and route funds straight to the bank account you already use.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none"><path d="M12 3v18M5 8h9a3 3 0 0 1 0 6H7a3 3 0 0 0 0 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
    title: 'Automated late fees',
    description: 'Set a grace period once, and Pathlight applies the fee and follow-up email exactly the same way, every time.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none"><path d="M4 19V6a2 2 0 0 1 2-2h9l5 5v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" stroke="currentColor" stroke-width="1.6"/><path d="M14 4v5h5" stroke="currentColor" stroke-width="1.6"/></svg>',
    title: 'Exportable records',
    description: 'Download a clean CSV of every invoice and payment each quarter, ready to hand to your accountant.',
  },
];

const testimonials = [
  {
    quote: "I stopped chasing clients for payment. Pathlight sends the reminder before I even think about it, and I get paid three to five days faster on average.",
    name: 'Renata Ibarra',
    role: 'Brand designer',
    company: 'Studio Ibarra',
    avatar: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=200&h=200&fit=crop&crop=faces',
  },
  {
    quote: 'Our five-person agency runs its entire billing cycle through Pathlight now. The dashboard is the first thing our finance lead opens every morning.',
    name: 'Marcus Webb',
    role: 'Operations lead',
    company: 'Fieldstone Collective',
    avatar: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&h=200&fit=crop&crop=faces',
  },
  {
    quote: 'Switching from spreadsheets took one afternoon. Clients say the checkout page feels more trustworthy than the invoices we used to send as PDFs.',
    name: 'Priya Shah',
    role: 'Independent consultant',
    company: 'Shah Advisory',
    avatar: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=200&h=200&fit=crop&crop=faces',
  },
];

const plans = [
  {
    name: 'Starter',
    price: '$0',
    description: 'For freelancers sending a handful of invoices a month.',
    features: ['Up to 5 invoices / month', 'Card payments', 'Standard checkout page', 'Email support'],
  },
  {
    name: 'Professional',
    price: '$29',
    description: 'For consultants and small teams billing regularly.',
    features: ['Unlimited invoices', 'Card, ACH & wire', 'Custom checkout branding', 'Automated reminders', 'Priority support'],
    featured: true,
  },
  {
    name: 'Agency',
    price: 'Custom',
    description: 'For agencies managing multiple clients and seats.',
    features: ['Everything in Professional', 'Multiple team seats', 'Role-based permissions', 'Dedicated account manager'],
  },
];

const faqs = [
  { q: 'How fast do I actually get paid?', a: 'Card payments typically settle to your bank account within two business days. ACH transfers usually take three to five business days, and wire transfers arrive the same or next business day.' },
  { q: 'What does Pathlight cost my clients?', a: 'Nothing. Your client only ever sees the amount on the invoice. Pathlight fees are billed to you, the account holder, according to your plan.' },
  { q: 'Can I use my own domain for the checkout page?', a: 'Yes, on the Professional and Agency plans you can point a subdomain, like pay.yourstudio.com, at your Pathlight checkout page.' },
  { q: 'Is my clients\u2019 card data stored on my servers?', a: 'No. Checkout pages are hosted by Pathlight and are PCI-DSS compliant, so card details never pass through your own systems.' },
  { q: 'Can I cancel at any time?', a: 'Yes. There are no long-term contracts. You can downgrade to Starter or cancel your subscription from account settings whenever you like.' },
];
---

<Layout
  title="Pathlight — Get invoices paid, without the chasing"
  description="Pathlight is invoicing and payment collection built for independent consultants and small agencies. Send an invoice, watch it get viewed, and get paid faster."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Invoicing &amp; payments</span>
        <h1>Get invoices paid, without the chasing.</h1>
        <p class="lead">
          Pathlight turns a sent invoice into a tracked payment. Send it, watch your client open it,
          and get notified the moment the money lands, no spreadsheets required.
        </p>
        <div class="hero-actions">
          <a href="/checkout" class="btn btn-primary">Start free</a>
          <a href="/services" class="btn btn-secondary">See how it works</a>
        </div>
        <div class="hero-trust">
          <span>Trusted by 4,200+ independent businesses</span>
        </div>
      </div>
      <div class="hero-visual">
        <PaymentPath />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">What you get</span>
        <h2>Everything between "send" and "paid"</h2>
        <p>Six tools that replace the spreadsheet, the reminder emails, and the separate payment link.</p>
      </div>
      <div class="feature-grid">
        {features.map((f) => <FeatureCard {...f} />)}
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="section benefits">
    <div class="container benefits-grid">
      <div class="section-head">
        <span class="eyebrow">Why Pathlight</span>
        <h2>Built for the business of one, not the enterprise of thousands</h2>
        <p>
          Most payment platforms are built for large finance teams. Pathlight is built for the person
          who is also the finance team, so setup takes minutes and the dashboard fits on one screen.
        </p>
        <div class="trust-badges">
          <span class="badge">PCI-DSS compliant</span>
          <span class="badge">256-bit encryption</span>
          <span class="badge">SOC 2 in progress</span>
        </div>
      </div>
      <div class="stat-grid">
        <div class="stat-item">
          <div class="stat-number">4.3 days</div>
          <p>Average time saved getting paid, vs. manual invoicing</p>
        </div>
        <div class="stat-item">
          <div class="stat-number">98%</div>
          <p>Of invoices opened within 24 hours of sending</p>
        </div>
        <div class="stat-item">
          <div class="stat-number">$41M+</div>
          <p>Processed for independent businesses since 2022</p>
        </div>
        <div class="stat-item">
          <div class="stat-number">4,200+</div>
          <p>Consultants and small agencies billing on Pathlight</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section" id="testimonials">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Customers</span>
        <h2>What people building their own business say</h2>
      </div>
      <div class="testimonial-grid">
        {testimonials.map((t) => <TestimonialCard {...t} />)}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section pricing" id="pricing">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Pricing</span>
        <h2>One plan for every stage of billing</h2>
        <p>Start free. Upgrade only once invoicing outgrows a single spreadsheet.</p>
      </div>
      <div class="pricing-grid">
        {plans.map((p) => <PricingCard {...p} />)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq" id="faq">
    <div class="container narrow">
      <div class="section-head center">
        <span class="eyebrow">Questions</span>
        <h2>Frequently asked questions</h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="container">
      <h2>Send your next invoice through Pathlight</h2>
      <p>Free to start. No card required until you send your first paid invoice.</p>
      <a href="/checkout" class="btn btn-primary">Start free</a>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 76px 0 40px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero-copy { max-width: 540px; }
  .lead { font-size: 1.12rem; margin-bottom: 30px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 28px; }
  .hero-trust { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-faint); }
  .hero-visual { display: flex; justify-content: center; }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .benefits { background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .trust-badges { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .stat-item p { font-size: 0.86rem; margin-top: 6px; }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .container.narrow { max-width: 760px; }

  .final-cta {
    background: linear-gradient(135deg, var(--primary-dark), var(--primary));
    color: #fff;
    text-align: center;
    padding: 96px 0;
  }
  .final-cta h2 { color: #fff; margin-bottom: 12px; }
  .final-cta p { color: rgba(255,255,255,0.82); margin-bottom: 30px; }
  .final-cta .btn-primary { background: #fff; color: var(--primary-dark); box-shadow: none; }
  .final-cta .btn-primary:hover { background: var(--accent-tint); }

  @media (max-width: 960px) {
    .hero-grid, .benefits-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; }
    .feature-grid, .testimonial-grid, .pricing-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .feature-grid, .testimonial-grid, .pricing-grid, .stat-grid { grid-template-columns: 1fr; }
  }
</style>
