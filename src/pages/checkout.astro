---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Checkout"
  description="Complete your payment securely through Pathlight's hosted checkout."
>
  <section class="section checkout-section">
    <div class="container narrow">
      <div class="checkout-head">
        <span class="eyebrow">Secure checkout</span>
        <h1>Complete your payment</h1>
        <p>Enter the email you'd like the receipt sent to and the amount you're paying. Your card details are never stored on our servers.</p>
      </div>

      <form id="checkout-form" class="checkout-card card" novalidate>
        <div class="field">
          <label for="email">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@company.com"
            autocomplete="email"
            required
            aria-describedby="email-error"
          />
          <p class="field-error" id="email-error" role="alert"></p>
        </div>

        <div class="field">
          <label for="amount">Amount (USD)</label>
          <div class="amount-input">
            <span class="prefix">$</span>
            <input
              type="number"
              id="amount"
              name="amount"
              placeholder="0.00"
              min="0.01"
              step="0.01"
              inputmode="decimal"
              required
              aria-describedby="amount-error"
            />
          </div>
          <p class="field-error" id="amount-error" role="alert"></p>
        </div>

        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>

        <button type="submit" class="btn btn-primary btn-block" id="submit-btn">
          <span id="btn-label">Pay now</span>
        </button>

        <p class="secure-note">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 7V5a4 4 0 0 1 8 0v2M3 7h10v7H3V7Z" stroke="currentColor" stroke-width="1.3"/></svg>
          Payments are encrypted and processed over a secure connection.
        </p>
      </form>
    </div>
  </section>
</Layout>

<script>

  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const amountInput = document.getElementById('amount') as HTMLInputElement;
  const emailError = document.getElementById('email-error') as HTMLElement;
  const amountError = document.getElementById('amount-error') as HTMLElement;
  const formStatus = document.getElementById('form-status') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnLabel = document.getElementById('btn-label') as HTMLElement;

  let isSubmitting = false;

  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function validateEmail(): boolean {
    const value = emailInput.value.trim();
    if (!value) {
      emailError.textContent = 'Email is required.';
      return false;
    }
    if (!emailPattern.test(value)) {
      emailError.textContent = 'Enter a valid email address.';
      return false;
    }
    emailError.textContent = '';
    return true;
  }

  function validateAmount(): boolean {
    const raw = amountInput.value.trim();
    if (!raw) {
      amountError.textContent = 'Amount is required.';
      return false;
    }
    const value = Number(raw);
    if (Number.isNaN(value) || value <= 0) {
      amountError.textContent = 'Amount must be greater than 0.';
      return false;
    }
    amountError.textContent = '';
    return true;
  }

  emailInput.addEventListener('blur', validateEmail);
  amountInput.addEventListener('blur', validateAmount);
  emailInput.addEventListener('input', () => { if (emailError.textContent) validateEmail(); });
  amountInput.addEventListener('input', () => { if (amountError.textContent) validateAmount(); });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (isSubmitting) return;

    const emailOk = validateEmail();
    const amountOk = validateAmount();
    if (!emailOk || !amountOk) {
      formStatus.textContent = '';
      return;
    }

    isSubmitting = true;
    submitBtn.disabled = true;
    btnLabel.textContent = 'Processing…';
    formStatus.className = 'form-status';
    formStatus.textContent = '';
    const randomNumber = Math.floor(10000000 + Math.random() * 90000000);

    const payload = {
      email: emailInput.value.trim(),
      transaction_id: randomNumber,
      sales_amount: Number(amountInput.value),
    };

    try {
      const response = await fetch("/.netlify/functions/checkout", {
          method: "POST",
          headers: {
              "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
      });

      if (!response.ok) {
        throw new Error(`Webhook responded with status ${response.status}`);
      }

      const params = new URLSearchParams({
        email: payload.email,
        amount: payload.amount.toFixed(2),
      });
      window.location.href = `/thank-you?${params.toString()}`;
    } catch (err) {
      formStatus.classList.add('is-error');
      formStatus.textContent = 'We could not process that payment. Please check your details and try again.';
      isSubmitting = false;
      submitBtn.disabled = false;
      btnLabel.textContent = 'Pay now';
    }
  });
</script>

<style>
  .checkout-section { padding-top: 72px; }
  .container.narrow { max-width: 480px; }

  .checkout-head { text-align: center; margin-bottom: 36px; }
  .checkout-head p { font-size: 0.95rem; }

  .checkout-card {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .field { display: flex; flex-direction: column; gap: 6px; }

  label {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink);
  }

  input {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  input:focus-visible {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-tint);
  }

  input:invalid:not(:placeholder-shown) {
    box-shadow: none;
  }

  .amount-input {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    overflow: hidden;
  }
  .amount-input:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-tint);
  }
  .amount-input .prefix {
    display: flex;
    align-items: center;
    padding: 0 12px;
    font-family: var(--font-mono);
    color: var(--ink-faint);
    background: rgba(20,27,45,0.03);
    border-right: 1px solid var(--border);
  }
  .amount-input input {
    border: none;
    background: transparent;
    flex: 1;
    box-shadow: none !important;
  }

  .field-error {
    margin: 0;
    font-size: 0.8rem;
    color: var(--danger);
    min-height: 1em;
  }

  .form-status {
    margin: 0;
    font-size: 0.86rem;
    text-align: center;
  }
  .form-status.is-error {
    color: var(--danger);
    background: var(--danger-tint);
    padding: 10px 12px;
    border-radius: var(--radius-sm);
  }

  .secure-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin: 0;
  }

  button:disabled { opacity: 0.7; cursor: not-allowed; }
</style>
