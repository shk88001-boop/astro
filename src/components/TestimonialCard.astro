---
interface Props {
  quote: string;
  name: string;
  role: string;
  company: string;
  avatar: string;
}
const { quote, name, role, company, avatar } = Astro.props;
---

<figure class="testimonial card">
  <div class="stars" aria-hidden="true">★★★★★</div>
  <blockquote>{quote}</blockquote>
  <figcaption>
    <img src={avatar} alt={`Portrait of ${name}`} width="44" height="44" loading="lazy" />
    <div>
      <div class="name">{name}</div>
      <div class="role">{role}, {company}</div>
    </div>
  </figcaption>
</figure>

<style>
  .testimonial {
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .stars { color: var(--accent); letter-spacing: 2px; font-size: 0.85rem; }
  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.5;
    color: var(--ink);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }
  figcaption img { border-radius: 50%; object-fit: cover; }
  .name { font-weight: 600; font-size: 0.92rem; }
  .role { font-size: 0.84rem; color: var(--ink-faint); }
</style>
