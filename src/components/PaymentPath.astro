---
---

<div class="payment-path" role="img" aria-label="Diagram showing an invoice moving from sent, to viewed, to paid">
  <svg viewBox="0 0 520 360" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="pathGrad" x1="20" y1="300" x2="480" y2="60" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#0F6A5C"/>
        <stop offset="1" stop-color="#C9A227"/>
      </linearGradient>
    </defs>

    <path class="track" d="M40 300 C 140 300, 150 190, 240 190 S 360 90, 480 70" stroke="#E3E7EC" stroke-width="2" fill="none"/>
    <path class="draw" d="M40 300 C 140 300, 150 190, 240 190 S 360 90, 480 70" stroke="url(#pathGrad)" stroke-width="2.5" fill="none" stroke-linecap="round"/>

    <g class="node n1">
      <circle cx="40" cy="300" r="20" fill="#FFFFFF" stroke="#0F6A5C" stroke-width="1.6"/>
      <path d="M32 300h16M40 292v16" stroke="#0F6A5C" stroke-width="1.6" stroke-linecap="round"/>
    </g>
    <text x="40" y="336" text-anchor="middle" class="label">Invoice sent</text>
    <text x="40" y="280" text-anchor="middle" class="amount">$0</text>

    <g class="node n2">
      <circle cx="240" cy="190" r="20" fill="#FFFFFF" stroke="#0F6A5C" stroke-width="1.6"/>
      <path d="M232 190h11M247 184l4 6-4 6" stroke="#0F6A5C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    <text x="240" y="226" text-anchor="middle" class="label">Viewed</text>

    <g class="node n3">
      <circle cx="480" cy="70" r="24" fill="#0F6A5C"/>
      <path d="M470 70l7 7 13-15" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    <text x="480" y="110" text-anchor="middle" class="label strong">Paid</text>
    <text x="480" y="48" text-anchor="middle" class="amount accent">$2,400</text>
  </svg>
</div>

<style>
  .payment-path {
    width: 100%;
    max-width: 480px;
  }

  svg { width: 100%; height: auto; }

  .track { opacity: 0.6; }

  .draw {
    stroke-dasharray: 640;
    stroke-dashoffset: 640;
    animation: draw 2.2s ease forwards 0.3s;
  }

  .node {
    opacity: 0;
    transform-origin: center;
    animation: pop 0.5s ease forwards;
  }
  .n1 { animation-delay: 0.3s; }
  .n2 { animation-delay: 1.1s; }
  .n3 { animation-delay: 2.1s; }

  .n3 circle {
    animation: pulse 2.4s ease-in-out infinite 2.6s;
  }

  .label {
    font-family: 'Public Sans', sans-serif;
    font-size: 12px;
    fill: var(--ink-soft, #545E70);
    opacity: 0;
    animation: fade 0.5s ease forwards;
  }
  .label.strong { fill: var(--ink, #141B2D); font-weight: 600; }

  .amount {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    fill: var(--ink-faint, #8A93A3);
    opacity: 0;
    animation: fade 0.5s ease forwards 0.4s;
  }
  .amount.accent { fill: #C9A227; font-weight: 500; animation-delay: 2.3s; }

  text.label { animation-delay: inherit; }
  .n1 ~ text.label, .n1 + text.label { animation-delay: 0.5s; }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.6); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes fade {
    to { opacity: 1; }
  }
  @keyframes pulse {
    0%, 100% { filter: drop-shadow(0 0 0 rgba(15,106,92,0)); }
    50% { filter: drop-shadow(0 0 8px rgba(15,106,92,0.5)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .draw, .node, .label, .amount, .n3 circle {
      animation: none !important;
      opacity: 1 !important;
      stroke-dashoffset: 0 !important;
    }
  }
</style>
