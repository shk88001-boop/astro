      </div>
    </div>

    <div class="footer-col">
      <h3>Product</h3>
      <ul>
        <li><a href="/services">Services</a></li>
        <li><a href="/checkout">Checkout</a></li>
        <li><a href="/#pricing">Pricing</a></li>
        <li><a href="/#faq">FAQ</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Company</h3>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/about#team">Team</a></li>
        <li><a href="/#testimonials">Customers</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Resources</h3>
      <ul>
        <li><a href="/services#process">How it works</a></li>
        <li><a href="/#faq">Support</a></li>
        <li><a href="/checkout">Get started</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} Pathlight, Inc. All rights reserved.</p>
    <div class="legal-links">
      <a href="#">Privacy</a>
      <a href="#">Terms</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #C7CDD8;
    padding: 72px 0 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .footer-brand .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: #fff;
    margin-bottom: 12px;
  }

  .footer-brand p {
    color: #9AA3B4;
    max-width: 280px;
    font-size: 0.9rem;
  }

  .socials {
    display: flex;
    gap: 12px;
    margin-top: 18px;
  }

  .socials a {
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    color: #C7CDD8;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .socials a:hover { background: var(--primary); color: #fff; }

  .footer-col h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7C8698;
    font-weight: 500;
    margin-bottom: 16px;
  }

  .footer-col ul {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col a {
    font-size: 0.92rem;
    color: #C7CDD8;
    transition: color 0.15s ease;
  }

  .footer-col a:hover { color: #fff; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 24px;
    font-size: 0.82rem;
    color: #7C8698;
  }

  .legal-links { display: flex; gap: 20px; }
  .legal-links a:hover { color: #fff; }

  @media (max-width: 800px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-bottom { flex-direction: column; gap: 10px; text-align: center; }
  }
</style>
