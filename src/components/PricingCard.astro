---
interface Props {
  name: string;
  price: string;
  period?: string;
  description: string;
  features: string[];
  featured?: boolean;
}
const { name, price, period = '/mo', description, features, featured = false } = Astro.props;
---

<div class={`plan card ${featured ? 'featured' : ''}`}>
  {featured && <span class="tag">Most popular</span>}
  <h3>{name}</h3>
  <p class="desc">{description}</p>
  <div class="price">
    <span class="amount">{price}</span>
    {price !== 'Custom' && <span class="period">{period}</span>}
  </div>
  <a href="/checkout" class={`btn btn-block ${featured ? 'btn-primary' : 'btn-secondary'}`}>
    {price === 'Custom' ? 'Talk to sales' : 'Choose plan'}
  </a>
  <ul>
    {features.map((f) => (
      <li>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5L6.2 11.5L13 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {f}
      </li>
    ))}
  </ul>
</div>

<style>
  .plan {
    padding: 32px 28px;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .plan.featured {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
    transform: scale(1.02);
  }
  .tag {
    position: absolute;
    top: -13px; left: 28px;
    background: var(--accent);
    color: #3A2E05;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 100px;
    letter-spacing: 0.04em;
  }
  h3 { margin-bottom: 6px; }
  .desc { font-size: 0.88rem; margin-bottom: 20px; min-height: 42px; }
  .price { display: flex; align-items: baseline; gap: 6px; margin-bottom: 22px; }
  .amount { font-family: var(--font-mono); font-size: 2.1rem; color: var(--ink); font-weight: 500; }
  .period { color: var(--ink-faint); font-size: 0.88rem; }
  .btn { margin-bottom: 24px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  li { display: flex; align-items: flex-start; gap: 10px; font-size: 0.9rem; color: var(--ink-soft); }
  li svg { color: var(--primary); flex-shrink: 0; margin-top: 3px; }
</style>
